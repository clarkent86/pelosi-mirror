# Copy to .env and fill in. Keep .env private: it holds your Fidelity login.

# --- Fidelity ---
# The account the strategy trades in, as shown on Fidelity (e.g. Z12345678).
FIDELITY_ACCOUNT=
# Optional. Lets the app sign itself back in when Fidelity's session times out. This only
# works after you've signed in once in the browser and ticked "Don't ask me again on this device".
FIDELITY_USERNAME=
FIDELITY_PASSWORD=

# --- How much to invest ---
# Cash in the account the strategy may use when it starts (first run only). Change it
# later on the web page. Shares you already hold in the model's tickers also count.
INITIAL_CASH=1000

# --- Logins for this app ---
# Password for the web page at http://<server>:3013 (any username).
WEB_PASSWORD=
# Login for the browser desktop at https://<server>:3001
BROWSER_USER=me
BROWSER_PASSWORD=

# Links used in Discord messages and on the web page. Use your server's LAN address.
PUBLIC_URL=http://192.168.1.50:3013
BROWSER_URL=https://192.168.1.50:3001

# --- Discord (optional, recommended) ---
# Bot token and your own user id. Without them, approve on the web page instead.
DISCORD_TOKEN=
DISCORD_USER_ID=

# --- Tuning (defaults shown) ---
TZ=America/New_York
POLL_MINUTES=10     # how often to check for new filings (hourly overnight)
MIN_TRADE=5         # skip changes smaller than this many dollars
CASH_RESERVE=5      # leave this much cash uninvested
MEMBER_LAST=Pelosi  # whose filings to follow (see README before changing)
MEMBER_STATE=CA
# DEBUG=1           # developer endpoints (/debug/*); leave off
